# =============================================================================
# Du lieu & model nang: khong dua len git
# =============================================================================

# Data - sample / raw / processed (giu lai .gitkeep)
data/samples/**
!data/samples/.gitkeep
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Outputs
outputs/**
!outputs/.gitkeep
scratch

# Pretrained / trained / fine-tuned weights (bat ky cap nao)
models/**
!models/**/.gitkeep

# Tool binaries duoc luu trong models/ (COLMAP, FFmpeg, ...)
*.exe
*.dll
*.zip

# HuggingFace / Torch cache
hf_cache/
torch_cache/
.cache/huggingface/

# =============================================================================
# Configs voi secret / duong dan may ca nhan
# =============================================================================
configs/local/
configs/*.local.yaml
configs/*.local.yml
.secrets

# =============================================================================
# Logs & profiling
# =============================================================================
logs/
*.log
*.prof
*.trace
wandb/
runs/
mlruns/
.neptune/

# =============================================================================
